# Site Configuration
VITE_SITE_URL=https://essaybridge.com
VITE_APP_NAME=EssayBridge

# API Configuration
VITE_API_URL=https://api.essaybridge.com
VITE_API_TIMEOUT=30000

# Payment Gateway (예시)
VITE_PAYMENT_KEY=your_payment_key_here
VITE_IAMPORT_USER_CODE=your_iamport_code

# Storage
VITE_UPLOAD_MAX_SIZE=10
VITE_ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.hwp

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_CHAT_SUPPORT=true

# Environment
VITE_ENV=production
