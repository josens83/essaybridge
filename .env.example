# App Configuration
VITE_APP_NAME=EssayBridge
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# API Configuration
VITE_API_BASE_URL=http://localhost:3001/api
VITE_API_TIMEOUT=30000
VITE_API_VERSION=v1

# Authentication
VITE_AUTH_TOKEN_KEY=essaybridge_token
VITE_AUTH_REFRESH_TOKEN_KEY=essaybridge_refresh_token
VITE_AUTH_TOKEN_EXPIRY=7200000
VITE_SESSION_TIMEOUT=3600000

# File Upload
VITE_UPLOAD_MAX_SIZE=10485760
VITE_UPLOAD_ALLOWED_TYPES=.pdf,.doc,.docx,.hwp,.txt
VITE_UPLOAD_ENDPOINT=/uploads

# Payment Integration (Toss Payments)
VITE_PAYMENT_PROVIDER=toss
VITE_TOSS_CLIENT_KEY=test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq
VITE_TOSS_SECRET_KEY=test_sk_zXLkKEypNArWmo50nX3lmeaxYG5R
VITE_TOSS_SUCCESS_URL=/payment/success
VITE_TOSS_FAIL_URL=/payment/fail

# S3 / Storage
VITE_STORAGE_PROVIDER=s3
VITE_S3_BUCKET=essaybridge-prod
VITE_S3_REGION=ap-northeast-2
VITE_CDN_URL=https://cdn.essaybridge.com

# Analytics
VITE_GA_TRACKING_ID=G-XXXXXXXXXX
VITE_HOTJAR_ID=
VITE_SENTRY_DSN=

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_CHAT_SUPPORT=false
VITE_MAINTENANCE_MODE=false

# Site URLs
VITE_SITE_URL=https://essaybridge.com
VITE_TERMS_URL=/terms
VITE_PRIVACY_URL=/privacy
VITE_HELP_CENTER_URL=/help

# Email Service
VITE_EMAIL_SERVICE_PROVIDER=sendgrid
VITE_SENDGRID_API_KEY=
VITE_SUPPORT_EMAIL=support@essaybridge.com

# Database (for reference - backend only)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=essaybridge
# DB_USER=postgres
# DB_PASSWORD=
# DB_SSL=false
# REDIS_URL=redis://localhost:6379
